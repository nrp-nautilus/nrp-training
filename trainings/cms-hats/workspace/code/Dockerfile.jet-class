FROM quay.io/jupyter/tensorflow-notebook:cuda-2024-04-22

USER root
WORKDIR /workspace

COPY code/jet_class.py code/analyze_jet_class.py /workspace/

RUN chmod +x /workspace/jet_class.py /workspace/analyze_jet_class.py \
    && mkdir -p /training/jet-class /tmp/openml \
    && chown -R 1000:100 /workspace /training /tmp/openml

USER 1000

ENV MPLBACKEND=Agg \
    OUTPUT_DIR=/training/jet-class \
    OPENML_CACHE_DIR=/tmp/openml \
    TF_CPP_MIN_LOG_LEVEL=2

CMD ["python", "/workspace/jet_class.py"]
